# === AI PROVIDER KEYS (multi-provider failover for JARVIS assistant) ===
# JARVIS tries Groq first, then OpenRouter, then Gemini — automatically switching
# when one provider hits its quota (429). Configure at least one key.
#
# Get free keys (no credit card required):
#   Groq:      https://console.groq.com/keys          (~14,400 req/day)
#   OpenRouter: https://openrouter.ai/keys            (free models with :free suffix)
#   Gemini:    https://aistudio.google.com/apikey     (~1,500 req/day)
GROQ_API_KEY="MY_GROQ_API_KEY"
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ADMIN_PASSKEY: Passkey for the hidden admin portal (Ctrl+Shift+A).
# FAIL-CLOSED: if this is NOT set, all admin endpoints return 503.
# Generate your own with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Do NOT reuse a value from this public file — generate a fresh one.
ADMIN_PASSKEY="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://mahmoud-wehaiba-portfolio.vercel.app"

# === GITHUB AUTOMATION (repo index + README → blog post generator) ===
# GITHUB_TOKEN: Optional PAT (Personal Access Token, fine-grained or classic with
# "repos" scope). When present, /api/github lists PRIVATE + public repos and can
# read READMEs for private repos. When absent, only public repos are returned.
# Create one here: https://github.com/settings/tokens
GITHUB_TOKEN="CHANGE_ME_TO_A_GITHUB_PAT"

# GITHUB_OWNER: The GitHub username whose repositories are indexed.
# Only used as the public-fallback user when GITHUB_TOKEN is not configured.
GITHUB_OWNER="meteoroite"

# === VERCEL KV / UPSTASH REDIS (persistent blog posts + sync state) ===
# Create a Vercel KV store (or Upstash Redis). Vercel auto-injects these
# KV_* variables into production. For local dev add the REST URL + token.
# KV_REST_API_URL="https://xxx.upstash.io"
# KV_REST_API_TOKEN="xxx"
# Alternatively Upstash's own variable names are also read:
# UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
# UPSTASH_REDIS_REST_API_TOKEN="xxx"
